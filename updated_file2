// TIMELINE CHART (Plotly)
// ═══════════════════════════════════════════════════════════════
function TimelineChart({ history, visibleLabels }) {
  const divRef = useRef(null);
  useEffect(() => {
    if (!divRef.current) return;
    if (!history.length) { Plotly.purge?.(divRef.current); return; }
    const df = [...history].sort((a,b) => new Date(a.predicted_at)-new Date(b.predicted_at));
    const times = df.map(r => r.predicted_at);
    const n = df.length;
    const RECENT_COUNT = 5;
    const RECENT_SPACE = 0.72; // 72% of axis space dedicated to recent points
    const SPLIT_X = 1 - RECENT_SPACE;

    // Build a piecewise x-axis: older points compressed, last RECENT_COUNT expanded.
    const xs = times.map((_, i) => {
      if (n <= RECENT_COUNT) {
        return n <= 1 ? 1 : (i / (n - 1)) * 100;
      }
      const olderCount = n - RECENT_COUNT;
      if (i < olderCount) {
        if (olderCount <= 1) return SPLIT_X * 100;
        return ((i / (olderCount - 1)) * SPLIT_X) * 100;
      }
      const recentIdx = i - olderCount;
      return ((SPLIT_X + (recentIdx / (RECENT_COUNT - 1)) * RECENT_SPACE)) * 100;
    });

    const tickvals = [];
    const ticktext = [];
    const fmtTime = t => new Date(t).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    if (n <= RECENT_COUNT) {
      for (let i = 0; i < n; i++) {
        tickvals.push(xs[i]);
        ticktext.push(fmtTime(times[i]));
      }
    } else {
      const olderCount = n - RECENT_COUNT;
      tickvals.push(xs[0]);
      ticktext.push(fmtTime(times[0]));
      if (olderCount > 2) {
        const midOld = Math.floor((olderCount - 1) / 2);
        tickvals.push(xs[midOld]);
        ticktext.push(fmtTime(times[midOld]));
      }
      tickvals.push(xs[olderCount - 1]);
      ticktext.push(fmtTime(times[olderCount - 1]));
      for (let i = n - RECENT_COUNT; i < n; i++) {
        tickvals.push(xs[i]);
        ticktext.push(fmtTime(times[i]));
      }
    }

    const mode = df.length < 2 ? 'markers' : 'lines+markers';
    const traces = LABEL_COLS
      .filter(lbl => (visibleLabels?.[lbl] ?? true) && df.some(r => r[lbl] !== undefined))
      .map(lbl => ({
        x: xs,
        y: df.map(r => r[lbl] !== undefined ? r[lbl] : null),
        customdata: df.map((r, idx) => ({
          level: r[lbl] !== undefined ? LEVEL_LABELS[r[lbl]] : null,
          ts: times[idx],
        })),
        mode, connectgaps: true,
        name: `${LABEL_EMOJIS[lbl]} ${lbl}`,
        line: { color: LABEL_COLORS[lbl], width: 3 },
        marker: { size: 7, color: LABEL_COLORS[lbl] },
        hovertemplate: `<b>${lbl}</b><br>%{customdata.ts}<br>level: %{customdata.level}<extra></extra>`,
      }));
    Plotly.react(divRef.current, traces, {
      margin: { l:60,r:10,t:10,b:10 }, height:360,
      paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)',
      xaxis: {
        showgrid:true,
        gridcolor:'rgba(80,80,100,0.2)',
        color:'#aaa',
        range:[0,100],
        tickmode:'array',
        tickvals,
        ticktext,
        tickangle:-30,
        title:{ text: n > RECENT_COUNT ? 'Time (recent 5 expanded)' : 'Time', font:{size:11,color:'#aaa'} },
      },
      yaxis: {
        range:[-0.5,3.5], tickmode:'array', tickvals:[0,1,2,3],
        ticktext:['Very Low','Low','High','Very High'],
        showgrid:true, gridcolor:'rgba(80,80,100,0.2)', color:'#aaa',
        zeroline:false, tickfont:{size:11,color:'#ccc'},
        title:{text:'Engagement Level',font:{size:12,color:'#ccc'}},
      },
      legend: { orientation:'h', yanchor:'bottom', y:1.12, xanchor:'center', x:0.5, font:{size:11,color:'#ccc'}, itemclick:'toggleothers', itemdoubleclick:'toggle' },
      font: { size:11, color:'#ccc' },
      hovermode: 'x unified',
      hoverlabel: { bgcolor:'rgba(20,20,30,0.95)', bordercolor:'#444', font:{color:'#fff'} },
    }, { displayModeBar:false, responsive:true });
  }, [history, visibleLabels]);

  if (!history.length) {
    return React.createElement('div', { className:'chart-placeholder' },
      React.createElement('div', null,
        '📊 Timeline appears after the first ', React.createElement('b',null,`${WINDOW_SECONDS}s`), ' window',
        React.createElement('br'),
        React.createElement('span', {style:{fontSize:'0.7rem'}}, `(${WINDOW_FRAMES} frames at ${CAPTURE_FPS} FPS)`),
      )
    );
  }
  return React.createElement('div', { ref:divRef, style:{width:'100%'} });
}

function computeOverallLevelPercentages(history) {
  const result = {};
  for (const label of LABEL_COLS) {
    const counts = [0, 0, 0, 0];
    for (const row of history) {
      const level = row[label];
      if (level !== undefined && level !== null && level >= 0 && level < 4) counts[level] += 1;
    }
    const total = counts.reduce((s, x) => s + x, 0) || 0;
    result[label] = counts.map(c => total ? +(c / total * 100).toFixed(0) : 0);
  }
  return result;
}

