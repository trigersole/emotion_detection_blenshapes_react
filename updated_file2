// Stores in a `manual_overrides` table: session_id, bucket_label, label_col,
// level_percentages (json), overridden_at.
// If the table doesn't exist yet it'll throw — gracefully caught in the UI.
async function saveManualOverride(sessionId, bucketLabel, labelCol, levelPercentages) {
  return sbRequest('manual_overrides', 'POST', {
    session_id:        sessionId,
    bucket_label:      bucketLabel,
    label_col:         labelCol,
    level_percentages: levelPercentages,  // array [veryLow%, low%, high%, veryHigh%]
    overridden_at:     new Date().toISOString(),
  });
}

async function clearManualOverride(sessionId, bucketLabel, labelCol) {
  if (!sessionId) return null;
  return sbRequest('manual_overrides', 'DELETE', null, {
    session_id: `eq.${sessionId}`,
    bucket_label: `eq.${bucketLabel}`,
    label_col: `eq.${labelCol}`,
  });
}

async function getManualOverrides(sessionId) {
  if (!sessionId) return [];
  return sbRequest('manual_overrides', 'GET', null, {
    select: 'bucket_label,label_col,level_percentages',
    session_id: `eq.${sessionId}`,
    order: 'overridden_at.desc',
  });
}

