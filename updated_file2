// SUPABASE HELPERS
// ═══════════════════════════════════════════════════════════════
async function sbRequest(table, method, body, params) {
  if (!SUPABASE_URL || !SUPABASE_KEY) return null;
  let url = `${SUPABASE_URL}/rest/v1/${table}`;
  if (params) url += '?' + new URLSearchParams(params).toString();
  const res = await fetch(url, {
    method,
    headers: {
      'Content-Type': 'application/json',
      'apikey': SUPABASE_KEY,
      'Authorization': `Bearer ${SUPABASE_KEY}`,
      'Prefer': 'return=representation',
    },
    body: body ? JSON.stringify(body) : undefined,
  });
  if (!res.ok) {
    const t = await res.text();
    throw new Error(`Supabase ${res.status}: ${t.slice(0, 200)}`);
  }
  if (res.status === 204) return null;
  const contentType = res.headers.get('content-type') || '';
  if (!contentType.includes('application/json')) return null;
  return res.json();
}

async function createSession(label = '', metadata = {}) {
  const data = await sbRequest('sessions', 'POST', { label, metadata });
  return data?.[0]?.id ?? null;
}

async function insertFrame(sessionId, features, faceDetected = true) {
  if (!sessionId) return null;
  const data = await sbRequest('blendshape_frames', 'POST', {
    session_id: sessionId, features, face_detected: faceDetected,
  });
  return data?.[0]?.id ?? null;
}

async function insertPrediction(frameId, sessionId, prediction) {
  if (!sessionId) return;
  const labelsFlat = {}, probsFlat = {};
  let maxConf = 0;
  for (const lbl of LABEL_COLS) {
    if (!prediction[lbl]) continue;
    labelsFlat[lbl] = prediction[lbl].label;
    probsFlat[lbl]  = prediction[lbl].probabilities;
    const conf = prediction[lbl].probabilities[prediction[lbl].label] ?? 0;
    if (conf > maxConf) maxConf = conf;
  }
  await sbRequest('emotion_predictions', 'POST', {
    frame_id: frameId ?? null,
    session_id: sessionId,
    label: JSON.stringify(labelsFlat),
    confidence: parseFloat(maxConf.toFixed(5)),
    probabilities: probsFlat,
    model_version: MODEL_VERSION,
  });
}

