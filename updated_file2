import { Client } from "@gradio/client";
let hfClient = null;
async function getHFClient() {
  if (!hfClient) {
    try { hfClient = await Client.connect(HF_SPACE, { hf_token: HF_TOKEN }); }
    catch (err) { hfClient = null; throw err; }
  }
  return hfClient;
}
async function classifyWindow(aggregatedFeatures) {
  try {
    const client = await getHFClient();
    const orderedFeatures = {};
    for (const k of FEATURE_ORDER) orderedFeatures[k] = aggregatedFeatures[k] ?? 0;
    const result = await client.predict("/predict", { agg_features: orderedFeatures });
    const raw = result?.data?.[0] ?? null;
    if (!raw) { console.warn('[HF] Empty response:', result); return null; }
    return raw;
  } catch (err) {
    console.error('[HF] classify error:', err);
    hfClient = null;
    return null;
  }
}

