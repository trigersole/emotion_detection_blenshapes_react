function bucketLevelPercentages(history, label, bucketMinutes = 5) {
  const ms = bucketMinutes * 60 * 1000;
  const rows = (history || [])
    .map(r => ({ ts: new Date(r.predicted_at).getTime(), level: r[label] }))
    .filter(r => r.level !== undefined && r.level !== null && !isNaN(r.ts));
  if (!rows.length) return { labels: [], percentagesPerLevel: [[], [], [], []] };
  const minTs = Math.min(...rows.map(r => r.ts));
  const maxTs = Math.max(...rows.map(r => r.ts));
  const start = Math.floor(minTs / ms) * ms;
  const end   = Math.ceil((maxTs + 1) / ms) * ms;
  const bucketStarts = [];
  for (let t = start; t < end; t += ms) bucketStarts.push(t);
  const counts = bucketStarts.map(() => [0, 0, 0, 0]);
  for (const r of rows) {
    const idx = Math.floor((r.ts - start) / ms);
    if (idx >= 0 && idx < counts.length && r.level >= 0 && r.level < 4) counts[idx][r.level] += 1;
  }
  const labels = bucketStarts.map(bs => {
    const s = new Date(bs), e = new Date(bs + ms);
    const pad = v => String(v).padStart(2, '0');
    return `${pad(s.getHours())}:${pad(s.getMinutes())}-${pad(e.getHours())}:${pad(e.getMinutes())}`;
  });
  const percentagesPerLevel = [[], [], [], []];
  for (const c of counts) {
    const total = c.reduce((s, x) => s + x, 0) || 0;
    for (let i = 0; i < 4; i++) percentagesPerLevel[i].push(total ? +(c[i] / total * 100).toFixed(0) : 0);
  }
  return { labels, percentagesPerLevel };
}

